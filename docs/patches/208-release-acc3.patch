+it("创建参与者后，音色可读回、更新、保留和清除", async () => {
+  const h = await makeHarness();
+  try {
+    const id = "voice-regression";
+    const initial = { voiceId: "xiaoyu", speed: 1 };
+    assert.deepEqual((await h.repo.upsertAgent({ id, voice: initial })).voice, initial);
+    const changed = { ...initial, speed: 1.1 };
+    assert.deepEqual((await h.repo.upsertAgent({ id, voice: changed })).voice, changed);
+    assert.deepEqual((await h.repo.upsertAgent({ id, displayName: "changed" })).voice, changed);
+    assert.equal((await h.repo.upsertAgent({ id, voice: null })).voice, null);
+  } finally {
+    await close(h);
+  }
+});

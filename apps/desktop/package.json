{
  "name": "@room/desktop",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Agent 评审室 桌面端（Electron 主进程 / preload / renderer 宿主）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "verify:sqlite": "node scripts/verify-sqlite.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test e2e/*.test.ts",
    "pack": "node scripts/pack.mjs",
    "pack:dir": "node scripts/pack.mjs --dir",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "pack:app": "node scripts/pack.mjs --app-only"
  },
  "dependencies": {
    "@room/core": "workspace:*",
    "@room/db": "workspace:*",
    "@room/remote-client": "workspace:*",
    "@room/schemas": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "yazl": "^3.3.1"
  }
}

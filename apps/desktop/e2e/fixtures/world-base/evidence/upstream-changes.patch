+          if (disc < 0) continue;
+          const root = Math.sqrt(disc);
+          enter = Math.max(enter, (-b - root) / (2 * a));
+          leave = Math.min(leave, (-b + root) / (2 * a));
+          if (enter > leave) continue;
+        }
+      } else {
